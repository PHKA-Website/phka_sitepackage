{
	"name": "phka/sitepackage",
	"description": "PHKA TYPO3 Site package",
	"keywords": ["typo3"],
	"homepage": "https://www.ph-karlsruhe.de",
	"type": "typo3-cms-extension",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Oliver Schmidt",
			"email": "webdev@ph-karlsruhe.de",
			"role": "Developer",
			"homepage": "https://ph-karlsruhe.de"
		}
	],
	"require": {
		"typo3/cms-core": "^13.4",
		"typo3/cms-fluid-styled-content": "^13.4"
	},
	"require-dev": {
		"typo3/coding-standards": "^0.8"
	},
	"extra": {
		"typo3/cms": {
			"extension-key": "phka_sitepackage"
		}
	},
	"autoload": {
		"psr-4": {
			"PHKA\\Sitepackage\\": "Classes/"
		}
	}
}
