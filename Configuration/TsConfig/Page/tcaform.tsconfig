TCEFORM {
    pages {
        doktype.keepItems = 1, 3, 4, 6, 199, 254
        backend_layout.keepItems = pagets__empty
        backend_layout_next_level.disabled = 1
        backend_layout_next_level.types {
            1 {
                disabled = 0
                keepItems = ,
            }
            6 {
                disabled = 0
                keepItems = ,
            }
            254 {
                disabled = 0
                keepItems = ,
            }
        }
    }
    tt_content {
        header.label = LLL:EXT:phka_sitepackage/Resources/Private/Language/locallang.be.xlf:header.ALT.formlabel
        header.types.header.label = LLL:EXT:frontend/Resources/Private/Language/locallang_ttc.xlf:header_formlabel
        header_layout.types.header {
            addItems {
                2 = H2
                3 = H3
                4 = H4
            }
            removeItems = 100
        }
        header_position.disabled = 1
        date.disabled = 1
        header_link.disabled = 1
        layout.disabled = 1
        frame_class.disabled = 1
        space_before_class.keepItems = medium
        sectionIndex.disabled = 1
        sectionIndex.types.header.disabled = 0
        subheader.disabled = 1
        subheader.types.header.disabled = 0
        linkToTop.disabled = 1
        categories.disabled = 1
    }
}

[extension.isLoaded('masi')]
TCEFORM {
    pages {
        exclude_slug_for_subpages.disabled = 1
        exclude_slug_for_subpages.types.254.disabled = 0
    }
}
[END]
